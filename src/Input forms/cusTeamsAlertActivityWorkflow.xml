<form _cs="Teams Alert Activity (cus)" created="2026-04-24 09:55:43.771Z" createdBy-id="246950230"
      entitySchema="xtk:form" img="xtk:form.png" label="Teams Alert Activity" lastModified="2026-04-24 10:00:47.259Z"
      md5="5438476AEC4585284537CA35A8336206" modifiedBy-id="246950230" name="teamsAlertActivityWorkflow"
      namespace="cus" xtkschema="xtk:form">
  <createdBy _cs="Iain Ollerenshaw"/>

  <form name="teamsAlertActivity">
    <container type="notebook">
      <!-- Main notebook tab -->
      <container img="nms:miniatures/mini-alert.png" label="Teams Alert">
        <container img="xtk:properties.png" label="Settings" type="frame">
          <input xpath="@label"/>
          <!-- Allow user to toggle the Errors transition -->
          <input label="Process errors" xpath="transitions/error[@name='error']/@enabled"/>
          <!-- Adds additional output logging -->
          <input xpath="@enableDebug"/>
        </container>

        <!-- Main properties -->
        <container img="nms:miniatures/mini-alert.png" label="WebHook Settings" type="frame">
          <input label="WebHook Option" xpath="@webHookUrlOptionName"/>
        </container>

        <container label="Card Styling" type="frame">
          <input xpath="@cardStyle"/>
          <input xpath="@headerColour"/>
          <static label="Container style effects the background of the card. Header colour applies to the header, subheader and icon."
                  type="help"/>
          <input xpath="@cardWidth"/>
          <static label="Consider using Full width if including a table." type="help"/>
        </container>

        <container label="Alert Contents" type="frame">
          <input xpath="@icon"/>
          <input xpath="@heading"/>
          <input xpath="@subheading"/>
          <input xpath="@alertText"/>
        </container>

      </container> <!-- Notebook -->

      <container img="xtk:table.png" label="Table">
        <input xpath="@includeTable"/>
        <container type="visibleGroup" visibleIf="@includeTable=true">
          <!-- Table container style -->
          <input xpath="@tableStyle"/>
          <!-- List of Table Columns -->
          <input editable="true" label="Table Columns" name="tableColumnList" type="list"
                 xpath="tableColumnList/tableColumn" zoom="false">
            <input xpath="@order"/>
            <input xpath="@headerName"/>
            <input xpath="@attribAlias"/>
            <input xpath="@relativeWidth"/>
          </input>
          <static label="Specify column header labels and attribute aliases to read from the inbound data set."
                  type="help"/>
        </container> <!-- Table visible group -->
      </container>

      <container img="xtk:operator.png" label="Tagging">
        <input xpath="@tagPeople"/>
        <container type="visibleGroup" visibleIf="@tagPeople=true">
          <input xpath="@assigneeType"/>
          <container type="visibleGroup" visibleIf="[@assigneeType]=0">
            <input createMode="none" img="xtk:group.png" noZoom="true" xpath="assignee">
              <sysFilter>
                <condition expr="@type=1"/>
              </sysFilter>
            </input>
          </container>
          <container type="visibleGroup" visibleIf="[@assigneeType]=1">
            <input createMode="none" img="xtk:operator.png" noZoom="true" xpath="operator">
              <sysFilter>
                <condition expr="@type=0"/>
              </sysFilter>
            </input>
          </container>
          <container type="visibleGroup" visibleIf="[@assigneeType]=2">
            <input label="Assignee" readOnly="true" required="true" xpath="assigneeFilter/@humanCond"/>
          </container>
          <input img="xtk:properties.png" label="Advanced parameters..." nolabel="true"
                 type="subFormLink" xpath=".">
            <form label="Advanced parameters">
              <enter>
                <set value="xtk:operator" xpath="assigneeFilter/@schema"/>
              </enter>
              <container type="visibleGroup" visibleIf="[@assigneeType]=2" xpath="assigneeFilter">
                <static label="Assignee" type="separator"/>
                <container ref="xtk:queryDef:where"/>
                <input expr="[/@helpCond]" type="expr" xpath="@humanCond"/>
              </container>
            </form>
          </input>
          <static label="Tagged operators/groups will be mentioned in the Teams post."
                  type="help"/>
        </container>

      </container>

      <!-- Advanced tab -->
      <container ref="xtk:workflow:lib/tabs/advancedActivityPage"/>

    </container>
  </form>
</form>